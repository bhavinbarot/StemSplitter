# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.

# --- Google OAuth (required only if REQUIRE_GOOGLE_LOGIN=true) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth / sessions ---
REQUIRE_GOOGLE_LOGIN=false
# Long random string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Storage paths ---
WEB_JOBS_ROOT=./web_jobs
WEB_LOGINS_ROOT=./web_logins
APP_DB_PATH=web_jobs/gauth.db

# --- Server / routing ---
PORT=5001
APP_PREFIX=
LITE_MODE=false
REQUEST_WORKER=false
UIVersion=

# --- yt-dlp (optional) ---
YTDLP_COOKIES_FILE=
